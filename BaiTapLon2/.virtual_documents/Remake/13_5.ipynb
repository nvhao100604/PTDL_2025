# 4. ĐỊNH DẠNG VÀ LƯU
ax.set_title('Top 20 Nghề nghiệp Đóng góp (FEC 2012)', fontsize=16)
ax.set_xlabel('Tổng Số tiền Đóng góp (USD)', fontsize=12)
