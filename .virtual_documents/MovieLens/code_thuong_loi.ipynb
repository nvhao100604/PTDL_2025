from sklearn.compose import ColumnTransformer
from sklearn.model_selection import train_test_split
df = tmdb_exploded.copy()

# Giả sử df đã có cột 'Genres' và 'avg_rating'
X = df[['Genres']]
y = df['avg_rating']

# One-hot encode
preprocessor = ColumnTransformer(
    transformers=[('onehot', OneHotEncoder(), ['Genres'])],
    remainder='drop'
)
X_encoded = preprocessor.fit_transform(X)

# Train/test split
X_train, X_test, y_train, y_test = train_test_split(X_encoded, y, test_size=0.2, random_state=42)

# Linear Regression
lr = LinearRegression()
lr.fit(X_train, y_train)
coef = lr.coef_

# Random Forest
rf = RandomForestRegressor(random_state=42)
rf.fit(X_train, y_train)
importance = rf.feature_importances_

# Lấy tên thể loại
genres = preprocessor.named_transformers_['onehot'].get_feature_names_out(['Genres'])

# Tạo DataFrame Linear
df_lr = pd.DataFrame({'Genre': genres, 'Coefficient': coef})
df_lr = df_lr.sort_values(by='Coefficient', ascending=False)

# Tạo DataFrame Random Forest
df_rf = pd.DataFrame({'Genre': genres, 'Importance': importance})
df_rf = df_rf.sort_values(by='Importance', ascending=False)

# Xuất top 10 ảnh hưởng tích cực/tiêu cực Linear
top_positive_lr = df_lr.head(10)
top_negative_lr = df_lr.tail(10)

# Xuất top 10 quan trọng Random Forest
top_rf = df_rf.head(10)

print("=== Top 10 thể loại tăng rating (Linear Regression) ===")
print(top_positive_lr)
print("\n=== Top 10 thể loại giảm rating (Linear Regression) ===")
print(top_negative_lr)
print("\n=== Top 10 thể loại quan trọng nhất (Random Forest) ===")
print(top_rf)






import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd

# --- Chuẩn bị dữ liệu Linear Regression ---
df_lr_sorted = df_lr.sort_values('Coefficient', ascending=True)

plt.figure(figsize=(10,6))
sns.barplot(x='Coefficient', y='Genre', data=df_lr_sorted, palette='coolwarm')
plt.title("Linear Regression Coefficients – Ảnh hưởng thể loại đến Rating")
plt.xlabel("Coefficient (tác động tới rating)")
plt.ylabel("Genre")
plt.axvline(0, color='black', linewidth=0.8)  # Thêm trục 0 để phân biệt tăng/giảm
plt.tight_layout()
plt.show()

# --- Chuẩn bị dữ liệu Random Forest ---
df_rf_sorted = df_rf.sort_values('Importance', ascending=True)

plt.figure(figsize=(10,6))
sns.barplot(x='Importance', y='Genre', data=df_rf_sorted, palette='viridis')
plt.title("Random Forest Feature Importance – Tầm quan trọng thể loại")
plt.xlabel("Feature Importance")
plt.ylabel("Genre")
plt.tight_layout()
plt.show()



import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd

# Tạo DataFrame từ kết quả
results = pd.DataFrame({
    'Model': ['Linear Regression', 'Ridge Regression', 'Lasso Regression', 'Random Forest', 'KNN'],
    'MAE': [0.39, 0.39, 0.42, 0.39, 0.43],
    'MSE': [0.25, 0.25, 0.27, 0.25, 0.29],
    'RMSE': [0.50, 0.50, 0.52, 0.50, 0.54]
})

# Vẽ biểu đồ RMSE
plt.figure(figsize=(10,6))
sns.barplot(x='RMSE', y='Model', data=results, palette='viridis')
plt.title('So sánh RMSE giữa các mô hình')
plt.xlabel('RMSE')
plt.ylabel('Mô hình')
plt.xlim(0, max(results['RMSE']) + 0.05)
plt.grid(axis='x', linestyle='--', alpha=0.6)
plt.show()












