# --- BƯỚC 3: KIỂM ĐỊNH THỐNG KÊ (ANOVA) ---
print("\n--- KẾT QUẢ KIỂM ĐỊNH ANOVA ---")

# Gom nhóm các list rating theo từng thể loại để chạy ANOVA
