plt.ylabel("vote_average")
plt.show()



subset_run[["runtime", "vote_average"]].corr()



subset_run["runtime_group"] = pd.cut(
    subset_run["runtime"],
    bins=[0, 90, 120, 180, 300],
    labels=["Ngắn (<90)", "Vừa (90–120)", "Dài (120–180)", "Rất dài (>180)"]
)

sns.boxplot(data=subset_run, x="runtime_group", y="vote_average")
