movies_pivot = movies_merged.join(genre_dummies)

# Tính điểm trung bình cho từng thể loại
genre_rating_mean = movies_pivot.groupby(genre_dummies.columns.tolist())["vote_average"].mean()

# Cách đơn giản hơn: tính trực tiếp
genre_rating_mean = pd.DataFrame({
    "Genre": genre_dummies.columns,
    "Average_Rating": (genre_dummies.mul(movies_merged["vote_average"], axis=0)).sum() / genre_dummies.sum()
})

# Vẽ biểu đồ cột
plt.figure(figsize=(14,6))
sns.barplot(data=genre_rating_mean.sort_values("Average_Rating", ascending=False), 
            x="Genre", y="Average_Rating")

plt.xticks(rotation=45)
plt.title("Điểm vote_average trung bình theo từng thể loại")
plt.ylabel("Điểm đánh giá trung bình")
plt.xlabel("Thể loại")
plt.show()


df = subset.copy()
df["Genres"] = df["Genres"].str.split("|")
df = df.explode("Genres")     # mỗi thể loại → 1 dòng



pivot = df.pivot_table(
    index="MovieID",          # hoặc Title nếu muốn
    columns="Genres",
    values="vote_average",    # chỉ cần value để pivot hoạt động
    aggfunc=lambda x: 1,   # nếu tồn tại → True
    fill_value=0
)


pivot


pivot_rating = df.pivot_table(
    index="Genres",
    values="vote_average",
    aggfunc="mean"
)

pivot_rating.plot(kind="bar", figsize=(10,5))
plt.title("Rating trung bình theo từng thể loại")
plt.ylabel("vote_average")
plt.xlabel("Genres")
plt.tight_layout()
plt.show()



genre_popularity = pivot.sum().sort_values(ascending=False)

genre_popularity.plot(kind="bar", figsize=(10,5))
plt.title("Độ phổ biến của từng thể loại")
plt.ylabel("Số lượng phim")
plt.xlabel("Genres")
plt.tight_layout()
plt.show()



