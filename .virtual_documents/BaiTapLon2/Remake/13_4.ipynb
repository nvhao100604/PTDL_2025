import pandas as pd
import matplotlib.pyplot as plt
import plotly.express as px
import seaborn as sns






import os

# 1. Định nghĩa đường dẫn và tên thư mục
folder_name = "images" 

# 2. Tạo thư mục
os.makedirs(folder_name, exist_ok=True) 








import json
db = json.load(open("../datasets/usda_food/database.json"))
print("Số phần tử:", len(db))








info_keys = ["description", "group", "id", "manufacturer"]
info = pd.DataFrame(db, columns=info_keys)
info.head()





nutrients = []
for rec in db:
    fnuts = pd.DataFrame(rec["nutrients"])
    fnuts["id"] = rec["id"]
    nutrients.append(fnuts)
nutrients = pd.concat(nutrients, ignore_index=True)

nutrients





# Kiểm tra dữ liệu trùng
print("Số dữ liệu bị trùng:", nutrients.duplicated().sum())


# Tiến hành xử lý bằng drop_duplicates()
nutrients = nutrients.drop_duplicates()

# kiểm tra lại
print("Số dữ liệu bị trùng:", nutrients.duplicated().sum())





col_mapping = {"description" : "food", "group" : "fgroup"}
# Đổi tên cột
info = info.rename(columns=col_mapping, copy=False)

info.info()


# Trên DataFrame gốc
col_mapping = {"description" : "nutrient", "group" : "nutgroup"}
# Đổi tên cột
nutrients = nutrients.rename(columns=col_mapping, copy=False)

nutrients.info()






ndata = pd.merge(nutrients, info, on="id")

ndata.info()


ndata.head(10)








ndata[ndata['nutrient']=="Energy"].groupby('fgroup')['value'].mean().sort_values(ascending=False).plot(kind='barh', figsize=(8,6))
plt.xlabel("Average energy (kcal)")
plt.ylabel("Nhom thực phẩm")
plt.title("Trung bình năng lượng theo nhóm thực phẩm")
plt.tight_layout()
plt.savefig("images/average_energy_per_food_group.png")











protein_data = ndata[(ndata['fgroup']=="Dairy and Egg Products") & (ndata['nutrient']=="Protein")]
top_10 = protein_data.sort_values(by='value', ascending=False).head(10)
plt.figure(figsize=(8, 6))
sns.barplot(data=top_10, y='food', x='value', palette='Blues_r')
plt.xlabel('Protein (g)')
plt.ylabel('Loại thực phẩm')
plt.title('Top 10 thực phẩm chứa nhiều Protein nhất trong nhóm Dairy and Egg Products')
plt.tight_layout()
plt.show()








# Đếm số lượng loại chất dinh dưỡng (nutrient) khác nhau trong từng nhóm thực phẩm (fgroup)
diversity = ndata.groupby('fgroup')['nutrient'].nunique().reset_index()

# Đổi tên cột cho dễ hiểu
diversity.columns = ['Food Group', 'Unique Nutrients Count']

# Sắp xếp giảm dần để nhóm đa dạng nhất nằm trên cùng
diversity_sorted = diversity.sort_values(by='Unique Nutrients Count', ascending=False)

# Lấy nhóm có độ đa dạng dinh dưỡng cao nhất
most_diverse = diversity_sorted.iloc[0]
most_diverse


# Biểu đồ cột cho 10 nhóm thực phẩm có độ đa dạng dinh dưỡng cao nhất
plt.figure(figsize=(8, 6))
sns.barplot(data=diversity_sorted.head(10), 
            y='Food Group', 
            x='Unique Nutrients Count', 
            palette='viridis')

plt.title('Top 10 nhóm thực phẩm có độ đa dạng dinh dưỡng cao nhất')
plt.xlabel('Số lượng chất dinh dưỡng khác nhau')
plt.ylabel('Nhóm thực phẩm')
plt.tight_layout()
plt.show()











## Lọc dữ liệu theo nhóm và chất dinh dưỡng

# Lọc dữ liệu cho hai nhóm thực phẩm Meat và Dairy
df_meat = ndata[ndata['fgroup'].str.contains('Meat', case=False, na=False)]
df_dairy = ndata[ndata['fgroup'].str.contains('Dairy', case=False, na=False)]

# Lọc riêng 2 loại chất cần so sánh: Protein và Total lipid (fat)
nutrients = ['Protein', 'Total lipid (fat)']
df_meat = df_meat[df_meat['nutrient'].isin(nutrients)]
df_dairy = df_dairy[df_dairy['nutrient'].isin(nutrients)]


## Tính trung bình hàm lượng dinh dưỡng trong từng nhóm

# Tính trung bình hàm lượng protein và lipid cho mỗi nhóm
mean_meat = df_meat.groupby('nutrient')['value'].mean()
mean_dairy = df_dairy.groupby('nutrient')['value'].mean()


## So sánh trực quan bằng biểu đồ

# Gộp hai nhóm vào một DataFrame để vẽ
compare_df = pd.DataFrame({
    'Meat': mean_meat,
    'Dairy': mean_dairy
}).T  # chuyển vị để nutrient thành cột

compare_df = compare_df.reset_index().melt(id_vars='index', var_name='Nutrient', value_name='Value')
compare_df.rename(columns={'index': 'Group'}, inplace=True)

# Vẽ biểu đồ
plt.figure(figsize=(6, 5))
sns.barplot(data=compare_df, x='Nutrient', y='Value', hue='Group', palette='Set2')
plt.title('So sánh hàm lượng Protein và Lipid giữa nhóm Meat và Dairy')
plt.xlabel('Loại chất dinh dưỡng')
plt.ylabel('Hàm lượng trung bình (g/100g)')
plt.tight_layout()
plt.show()








### Lọc dữ liệu chỉ lấy hai nhóm thực phẩm: Grains và Vegetables
ndata_subset = ndata[ndata['fgroup'].str.contains('Grain|Vegetable', case=False, na=False)]

### Lọc hai loại chất cần phân tích: Energy và Protein
ndata_subset = ndata_subset[ndata_subset['nutrient'].isin(['Energy', 'Protein'])]

### Chuẩn hóa năng lượng về kcal (nếu đơn vị là kJ)
ndata_subset.loc[ndata_subset['units'] == 'kJ', 'value'] = ndata_subset['value'] / 4.184
ndata_subset.loc[ndata_subset['units'] == 'kJ', 'units'] = 'kcal'

### Dùng pivot_table để gom giá trị Energy và Protein thành 2 cột
pivot_ndata = ndata_subset.pivot_table(
    index=['food', 'fgroup'],   
    columns='nutrient',          
    values='value',           
    aggfunc='mean'    
).reset_index()

### Loại bỏ dòng bị thiếu dữ liệu
pivot_ndata = pivot_ndata.dropna(subset=['Energy', 'Protein'])

### Tính tỷ lệ Energy-to-Protein
pivot_ndata['Energy_to_Protein'] = pivot_ndata['Energy'] / pivot_ndata['Protein']

### Tính trung bình theo nhóm thực phẩm
ratio_by_group = pivot_ndata.groupby('fgroup')['Energy_to_Protein'].mean().reset_index()

### Vẽ biểu đồ so sánh
plt.figure(figsize=(7, 5))
sns.barplot(data=ratio_by_group, x='fgroup', y='Energy_to_Protein', palette='viridis')

plt.title('So sánh Tỷ lệ Energy-to-Protein giữa nhóm Grains và Vegetables')
plt.xlabel('Nhóm thực phẩm')
plt.ylabel('Tỷ lệ Energy-to-Protein (kcal/g protein)')
plt.tight_layout()
plt.show()















# Lọc dữ liệu chỉ lấy Energy và Total lipid (fat)
ndata_corr = ndata[ndata['nutrient'].isin(['Energy', 'Total lipid (fat)'])]

# Chuẩn hóa năng lượng về kcal
ndata_corr.loc[ndata_corr['units'] == 'kJ', 'value'] = ndata_corr['value'] / 4.184
ndata_corr.loc[ndata_corr['units'] == 'kJ', 'units'] = 'kcal'

# Tạo bảng pivot để Energy và Fat nằm cùng hàng
pivot_corr = ndata_corr.pivot_table(
    index=['food', 'fgroup'],
    columns='nutrient',
    values='value',
    aggfunc='mean'
).reset_index()

# Loại bỏ các dòng thiếu dữ liệu
pivot_corr = pivot_corr.dropna(subset=['Energy', 'Total lipid (fat)'])

# Tính hệ số tương quan Pearson
corr_value = pivot_corr['Energy'].corr(pivot_corr['Total lipid (fat)'])
print(f"Hệ số tương quan giữa Energy và Fat: {corr_value:.3f}")

# Vẽ biểu đồ scatter thể hiện mối tương quan
plt.figure(figsize=(7, 5))
sns.regplot(
    data=pivot_corr,
    x='Total lipid (fat)',
    y='Energy',
    scatter_kws={'alpha': 0.6},
    line_kws={'color': 'red'}
)
plt.title('Mối tương quan giữa Năng lượng (Energy) và Chất béo (Fat)')
plt.xlabel('Hàm lượng chất béo (g/100g)')
plt.ylabel('Năng lượng (kcal/100g)')
plt.tight_layout()
plt.show()











ndata_nutri = ndata[ndata['nutrient'].isin(['Energy', 'Protein'])]

# Tạo bảng pivot gồm Energy và Protein
pivot_nutri = ndata_nutri.pivot_table(
    index=['food', 'fgroup'],
    columns='nutrient',
    values='value',
    aggfunc='mean'
).reset_index()

# Loại bỏ dòng thiếu dữ liệu
pivot_nutri = pivot_nutri.dropna(subset=['Energy', 'Protein'])

# Chuẩn hóa đơn vị năng lượng về kcal nếu có cả kJ
if 'units' in ndata.columns:
    if (ndata.loc[ndata['nutrient'] == 'Energy', 'units'] == 'kJ').any():
        pivot_nutri['Energy'] = pivot_nutri['Energy'] / 4.184

# Tính tỷ lệ Energy/Protein
pivot_nutri['E_P_ratio'] = pivot_nutri['Energy'] / pivot_nutri['Protein']

# Lọc các thực phẩm có năng lượng cao nhưng protein thấp (E/P ratio cao)
threshold_energy = pivot_nutri['Energy'].quantile(0.75)    # năng lượng cao (top 25%)
threshold_protein = pivot_nutri['Protein'].quantile(0.25)  # protein thấp (bottom 25%)

empty_calories = pivot_nutri[
    (pivot_nutri['Energy'] > threshold_energy) &
    (pivot_nutri['Protein'] < threshold_protein)
]

# Lấy top 10 thực phẩm “năng lượng rỗng”
top_empty = empty_calories.sort_values(by='E_P_ratio', ascending=False).head(10)

# Biểu đồ minh họa
plt.figure(figsize=(8, 5))
sns.barplot(
    data=top_empty,
    y='food',
    x='E_P_ratio',
    palette='Oranges_r'
)
plt.title('Top 10 thực phẩm năng lượng cao nhưng protein thấp (“rỗng”)')
plt.xlabel('Tỷ lệ Energy/Protein (kcal/g protein)')
plt.ylabel('Loại thực phẩm')
plt.tight_layout()
plt.show()












# Lọc dữ liệu chỉ lấy Energy và Water
ndata_water = ndata[ndata['nutrient'].isin(['Energy', 'Water'])]

# Tạo bảng pivot để Energy và Water nằm cùng hàng
pivot_water = ndata_water.pivot_table(
    index=['food', 'fgroup'],
    columns='nutrient',
    values='value',
    aggfunc='mean'
).reset_index()

# Loại bỏ dòng thiếu dữ liệu
pivot_water = pivot_water.dropna(subset=['Energy', 'Water'])

# Nếu có dữ liệu ở đơn vị kJ, chuyển sang kcal
if 'units' in ndata.columns:
    if (ndata.loc[ndata['nutrient'] == 'Energy', 'units'] == 'kJ').any():
        pivot_water['Energy'] = pivot_water['Energy'] / 4.184

# Tính hệ số tương quan giữa Energy và Water
corr_value = pivot_water['Energy'].corr(pivot_water['Water'])
print(f"Hệ số tương quan giữa Water và Energy: {corr_value:.3f}")

# Vẽ biểu đồ scatter với đường hồi quy
plt.figure(figsize=(7, 5))
sns.regplot(
    data=pivot_water,
    x='Water',
    y='Energy',
    scatter_kws={'alpha': 0.6},
    line_kws={'color': 'red'}
)
plt.title('Mối tương quan giữa Hàm lượng Nước (Water) và Năng lượng (Energy)')
plt.xlabel('Hàm lượng nước (g/100g)')
plt.ylabel('Năng lượng (kcal/100g)')
plt.tight_layout()
plt.show()











import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler

# --- 1. Lọc dữ liệu cần thiết ---
key_nutrients = ['Protein', 'Total lipid (fat)', 
                 'Carbohydrate, by difference', 
                 'Fiber, total dietary', 'Energy']

ndata_balance = ndata[ndata['nutrient'].isin(key_nutrients)]

# --- 2. Pivot dữ liệu để mỗi nutrient là 1 cột ---
pivot_balance = ndata_balance.pivot_table(
    index=['food', 'fgroup'],
    columns='nutrient',
    values='value',
    aggfunc='mean'
).reset_index()

# --- 3. Loại bỏ dòng thiếu dữ liệu ---
pivot_balance = pivot_balance.dropna(subset=key_nutrients)

# --- 4. Tính trung bình theo nhóm thực phẩm ---
group_mean = pivot_balance.groupby('fgroup')[key_nutrients].mean().reset_index()

# --- 5. Chuẩn hóa dữ liệu (vì đơn vị khác nhau) ---
scaler = MinMaxScaler()
group_mean_scaled = group_mean.copy()
group_mean_scaled[key_nutrients] = scaler.fit_transform(group_mean[key_nutrients])

# --- 6. Tính chỉ số “Nutrition Balance Index” ---
group_mean_scaled['Nutrition_Balance_Index'] = group_mean_scaled[key_nutrients].mean(axis=1)

# --- 7. Xếp hạng nhóm thực phẩm ---
group_mean_scaled = group_mean_scaled.sort_values(by='Nutrition_Balance_Index', ascending=False)

# --- 8. In kết quả ---
print("Top nhóm thực phẩm có chỉ số cân bằng dinh dưỡng cao nhất:")
print(group_mean_scaled[['fgroup', 'Nutrition_Balance_Index']])

# --- 9. Vẽ biểu đồ ---
plt.figure(figsize=(10,6))
sns.barplot(
    data=group_mean_scaled,
    y='fgroup',
    x='Nutrition_Balance_Index',
    palette='viridis'
)
plt.title('Chỉ số cân bằng dinh dưỡng (Nutrition Balance Index) theo nhóm thực phẩm')
plt.xlabel('Nutrition Balance Index (chuẩn hóa)')
plt.ylabel('Nhóm thực phẩm')
plt.tight_layout()
plt.show()



