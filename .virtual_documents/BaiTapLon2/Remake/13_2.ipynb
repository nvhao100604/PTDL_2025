plt.title("Mối quan hệ giữa độ phổ biến và độ lệch chuẩn rating")
plt.xlabel("Số lượt đánh giá (Độ phổ biến)")
plt.ylabel("Độ lệch chuẩn (σ)")
plt.xscale('log')  # log-scale vì số lượt rating chênh lệch rất lớn
plt.show()

corr = movie_stats["count_rating"].corr(movie_stats["std_rating"])
