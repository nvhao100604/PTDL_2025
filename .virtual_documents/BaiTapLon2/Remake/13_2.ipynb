# Tính độ lệch chuẩn rating theo từng phim và giới tính
std_by_gender_movie = data.groupby(["title", "gender"])["rating"].std().unstack()

# Tính độ chênh lệch giữa nam & nữ
std_by_gender_movie["diff_std"] = (std_by_gender_movie["M"] - std_by_gender_movie["F"]).abs()

# Lấy top 10 phim có sự chênh lệch lớn nhất
top_diff_movies = std_by_gender_movie.sort_values("diff_std", ascending=False).head(10)

print("🎬 Top 10 phim có sự khác biệt độ lệch chuẩn giữa nam và nữ lớn nhất:")
print(top_diff_movies[["M", "F", "diff_std"]])



# Vẽ biểu đồ
plt.figure(figsize=(10,5))
top_diff_movies["diff_std"].sort_values().plot(kind="barh", color="orange")
plt.title("Phim có độ phân hóa ý kiến khác biệt nhất giữa nam và nữ")
plt.xlabel("|Δ std| (chênh lệch độ lệch chuẩn)")
plt.ylabel("Tên phim")
plt.show()





# Trích năm phát hành từ tiêu đề
import re
def extract_year(title):
    match = re.search(r'\((\d{4})\)', str(title))
    return int(match.group(1)) if match else np.nan

data["year"] = data["title"].apply(extract_year)

# Nhóm thập niên
def decade(y):
    if pd.isna(y): return np.nan
    return int(y // 10 * 10)

data["decade"] = data["year"].apply(decade)

# Tính độ lệch chuẩn trung bình rating theo thập niên
std_by_decade = data.groupby("decade")["rating"].std()


plt.figure(figsize=(8,5))
std_by_decade.plot(kind="bar", color="steelblue")
plt.title("Độ lệch chuẩn rating trung bình theo thập niên sản xuất phim")
plt.xlabel("Thập niên")
plt.ylabel("Độ lệch chuẩn (σ)")
plt.show()

print("\n📈 Độ lệch chuẩn trung bình theo thập niên:")
print(std_by_decade)





