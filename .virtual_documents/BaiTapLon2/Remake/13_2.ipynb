# Tạo nhóm thể loại "extreme" (horror, thriller, war, political, drama) và "soft" (romance, comedy)
extreme_genres = ["Horror", "Thriller", "War", "Drama", "Crime", "Political"]
soft_genres = ["Romance", "Comedy", "Animation", "Family"]

df_genres['group_type'] = df_genres['genres'].apply(
    lambda g: 'Extreme' if any(x.lower() in g.lower() for x in extreme_genres)
              else ('Soft' if any(x.lower() in g.lower() for x in soft_genres)
              else 'Other')
)

std_by_group = df_genres.groupby("group_type")["rating"].std()
plt.figure(figsize=(6,4))
std_by_group.plot(kind='bar', color=['red','pink','gray'])
plt.title("So sánh độ lệch chuẩn giữa phim 'Extreme' và 'Soft'")
