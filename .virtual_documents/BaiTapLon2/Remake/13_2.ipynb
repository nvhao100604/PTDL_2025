plt.xlabel("Nhóm thể loại")
plt.show()


print("\n🎭 Độ lệch chuẩn trung bình của nhóm thể loại:")
print(std_by_group)





movie_stats = data.groupby("title").agg(
    mean_rating=('rating', 'mean'),
    std_rating=('rating', 'std'),
    count_rating=('rating', 'count'),
    genres=('genres', 'first')
).dropna()
